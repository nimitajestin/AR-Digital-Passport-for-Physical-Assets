# --- Backend (REQUIRED: real PostgreSQL — no fallback, no simulation) ---
PORT=3000
# Local Docker Postgres (see docker-compose.yml):
DATABASE_URL=postgresql://arpassport:arpassport@localhost:5432/arpassport
# Or Supabase: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Test-only escape hatch (ephemeral data, never for demo/prod):
USE_MEMORY_DB=false
NODE_ENV=development
# Comma-separated origins in production, e.g. https://app.example.com
CORS_ORIGIN=*

# --- Dashboard (frontend/dashboard) ---
# API base URL consumed by the dashboard. No hard-coded production URLs.
# Local default if unset: http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api

# --- AR (frontend/ar) ---
# Overridden at runtime via window.ENV.API_BASE_URL; default /api.
AR_API_BASE_URL=/api
