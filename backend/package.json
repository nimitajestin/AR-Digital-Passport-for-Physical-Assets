{
  "name": "ar-digital-passport-backend",
  "version": "1.0.0",
  "description": "REST API for AR Digital Passport for Physical Assets (Dev 2)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest --runInBand --forceExit",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-db.js",
    "phone": "node scripts/urls.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 15000
  }
}
